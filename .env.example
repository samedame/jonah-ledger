# Copy to .env for scripts/local_run.sh. Never commit .env.
ANTHROPIC_API_KEY=
DISCORD_WEBHOOK_URL=
# Optional
JONAH_MODEL=claude-sonnet-5-5
# Set to "off" to silence Discord but keep logging
JONAH_ALERTS=on
# SEC asks automated clients to identify themselves; use any contact you are comfortable publishing
SEC_USER_AGENT="jonah-ledger research bot"
